page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #1f2329;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: #fff;
  color: #2563eb;
  border: 1rpx solid #2563eb;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.error-banner {
  background: #fef2f2;
  color: #b91c1c;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  border-bottom: 1rpx solid #fecaca;
}

.empty-hint {
  color: #8a8f99;
  text-align: center;
  padding: 60rpx 40rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
