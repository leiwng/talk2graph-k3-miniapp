.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #2563eb 0%, #3b82f6 320rpx, #f5f6f8 620rpx);
  padding: 160rpx 60rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
}

.brand-sub {
  font-size: 36rpx;
  color: #fff;
  margin-top: 16rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.features {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-top: 80rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 35, 41, 0.08);
}

.feature {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 2;
}

.login-btn {
  margin-top: 60rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.login-error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}
