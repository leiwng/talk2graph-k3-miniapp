{"nl": "画一个等边三角形 ABC，边长为 4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "equilateral", "polygon": "tri"}, {"type": "length", "segment": "AB", "value": 4}], "annotations": [{"target": "AB", "kind": "length"}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画一个内切圆半径为 3 的等腰三角形", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}, {"id": "inc", "kind": "circle", "definition": {"type": "incircle", "of": "tri"}}], "constraints": [{"type": "isoceles", "polygon": "tri", "apex": "A"}, {"type": "radius", "circle": "inc", "value": 3}, {"type": "angle", "a": "A", "b": "B", "c": "C", "value": 70}], "annotations": [{"target": "inc", "kind": "radius"}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画直角三角形 ABC，C 为直角顶点，BC=3，CA=4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "right_triangle", "polygon": "tri", "right_at": "C"}, {"type": "length", "segment": "BC", "value": 3}, {"type": "length", "segment": "CA", "value": 4}], "annotations": [{"target": "BC", "kind": "length"}, {"target": "CA", "kind": "length"}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画一个边长为 5 的正方形 ABCD", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "sq", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}], "constraints": [{"type": "equal_length", "segments": ["AB", "BC", "CD", "DA"]}, {"type": "perpendicular", "a": "AB", "b": "BC"}, {"type": "perpendicular", "a": "BC", "b": "CD"}, {"type": "length", "segment": "AB", "value": 5}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画圆 O，半径为 5，A、B 两点在圆上，AOB 角为 90 度", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 5}}], "constraints": [{"type": "on_circle", "point": "A", "circle": "circ"}, {"type": "on_circle", "point": "B", "circle": "circ"}, {"type": "angle", "a": "A", "b": "O", "c": "B", "value": 90}], "annotations": [{"target": "AB", "kind": "length"}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "画一个三角形 ABC 和它的外接圆", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}, {"id": "circ", "kind": "circle", "definition": {"type": "circumcircle", "of": "tri"}}], "constraints": [{"type": "length", "segment": "AB", "value": 5}, {"type": "length", "segment": "BC", "value": 6}, {"type": "length", "segment": "CA", "value": 7}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画一个菱形 ABCD，边长 4，∠A = 60°", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "rh", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}], "constraints": [{"type": "equal_length", "segments": ["AB", "BC", "CD", "DA"]}, {"type": "length", "segment": "AB", "value": 4}, {"type": "angle", "a": "D", "b": "A", "c": "B", "value": 60}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画一个矩形 ABCD，长 6 宽 4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "rect", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}], "constraints": [{"type": "perpendicular", "a": "AB", "b": "BC"}, {"type": "perpendicular", "a": "BC", "b": "CD"}, {"type": "perpendicular", "a": "CD", "b": "DA"}, {"type": "length", "segment": "AB", "value": 6}, {"type": "length", "segment": "BC", "value": 4}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画一个等腰直角三角形 ABC，C 为直角顶点，腰长 4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "right_triangle", "polygon": "tri", "right_at": "C"}, {"type": "equal_length", "segments": ["CA", "BC"]}, {"type": "length", "segment": "CA", "value": 4}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "圆 O 半径 5，AB 为直径，C 在圆上", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 5}}], "constraints": [{"type": "on_circle", "point": "A", "circle": "circ"}, {"type": "on_circle", "point": "B", "circle": "circ"}, {"type": "on_circle", "point": "C", "circle": "circ"}, {"type": "collinear", "points": ["A", "O", "B"]}], "labels": {"O": "O", "A": "A", "B": "B", "C": "C"}}}
{"nl": "画一个三角形 ABC，M 是 BC 的中点，连接 AM", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "M", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "AM", "kind": "segment", "a": "A", "b": "M"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "length", "segment": "AB", "value": 5}, {"type": "length", "segment": "BC", "value": 6}, {"type": "length", "segment": "CA", "value": 7}, {"type": "midpoint", "m": "M", "a": "B", "b": "C"}], "labels": {"A": "A", "B": "B", "C": "C", "M": "M"}}}
{"nl": "画一个平行四边形 ABCD，AB=6 BC=4 ∠A=70 度", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "p", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}], "constraints": [{"type": "parallelogram", "polygon": "p"}, {"type": "length", "segment": "AB", "value": 6}, {"type": "length", "segment": "BC", "value": 4}, {"type": "angle", "a": "D", "b": "A", "c": "B", "value": 70}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画一个平面直角坐标系", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-5, 5], "y_range": [-5, 5], "tick_step": 1, "show_grid": true}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画一个坐标系，x 轴从 -10 到 10，y 轴从 -6 到 6", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-10, 10], "y_range": [-6, 6], "tick_step": 2, "show_grid": true}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画直角三角形 ABC，C 为直角顶点，C 位于 AB 上方，BC=3，CA=4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "P0", "kind": "point", "hint": [0, 5]}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "right_triangle", "polygon": "tri", "right_at": "C"}, {"type": "length", "segment": "BC", "value": 3}, {"type": "length", "segment": "CA", "value": 4}, {"type": "same_side", "line": "AB", "point": "C", "ref": "P0"}], "annotations": [{"target": "BC", "kind": "length"}, {"target": "CA", "kind": "length"}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画三角形 ABC，AB=4，BC=3，∠B=60°；作三角形 ABC 关于点 B 的中心对称图形 A'B'C'", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}, {"id": "tri2", "kind": "transformed_polygon", "source": "tri", "transform": {"type": "central_symmetry", "center": "B"}, "vertex_suffix": "p"}], "constraints": [{"type": "length", "segment": "AB", "value": 4}, {"type": "length", "segment": "BC", "value": 3}, {"type": "angle", "a": "A", "b": "B", "c": "C", "value": 60}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画直角三角形 ABC，∠ABC=90°，AB=1，BC=2；将线段 AC 绕点 A 旋转 90° 得到线段 AD", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CA", "kind": "segment", "a": "C", "b": "A"}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}, {"id": "D", "kind": "transformed_point", "source": "C", "transform": {"type": "rotation", "center": "A", "angle": 90}}, {"id": "AD", "kind": "segment", "a": "A", "b": "D"}], "constraints": [{"type": "right_triangle", "polygon": "tri", "right_at": "B"}, {"type": "length", "segment": "AB", "value": 1}, {"type": "length", "segment": "BC", "value": 2}], "labels": {"A": "A", "B": "B", "C": "C"}}}
{"nl": "画函数 y = x^2 的图像，x 从 -3 到 3", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-4, 4], "y_range": [-1, 10], "tick_step": 1, "show_grid": true}, {"id": "c1", "kind": "curve", "expr": "x**2", "var": "x", "domain": [-3, 3], "samples": 300}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画反比例函数 y = 1/x 的图像", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-5, 5], "y_range": [-5, 5], "tick_step": 1, "show_grid": true}, {"id": "c1", "kind": "curve", "expr": "1/x", "var": "x", "domain": [-5, 5], "samples": 400}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画抛物线 y^2 = 2x 及其准线", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-3, 6], "y_range": [-4, 4], "tick_step": 1, "show_grid": true}, {"id": "c_upper", "kind": "curve", "expr": "sqrt(2*x)", "var": "x", "domain": [0, 6]}, {"id": "c_lower", "kind": "curve", "expr": "-sqrt(2*x)", "var": "x", "domain": [0, 6]}, {"id": "Dl_top", "kind": "point", "hint": [-0.5, 4]}, {"id": "Dl_bot", "kind": "point", "hint": [-0.5, -4]}, {"id": "directrix", "kind": "line", "a": "Dl_top", "b": "Dl_bot"}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "在坐标系中画反比例函数 y=6/x 的图像，A、B 两点都在函数图像上且直线 AB 经过原点", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point"}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-6, 6], "y_range": [-6, 6], "tick_step": 1, "show_grid": true}, {"id": "c1", "kind": "curve", "expr": "6/x", "var": "x", "domain": [-6, 6], "samples": 400}, {"id": "A", "kind": "point", "hint": [2, 3]}, {"id": "B", "kind": "point", "hint": [-2, -3]}, {"id": "AB", "kind": "line", "a": "A", "b": "B"}], "constraints": [{"type": "on_curve", "point": "A", "curve": "c1"}, {"type": "on_curve", "point": "B", "curve": "c1"}, {"type": "collinear", "points": ["A", "O", "B"]}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "圆 O 半径为 5，A、B 两点在圆上且圆心角 AOB 为 60°，画从 A 到 B 的弧", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [5, 0]}, {"id": "B", "kind": "point", "hint": [2.5, 4.33]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 5}}, {"id": "arc1", "kind": "arc", "center": "O", "from_point": "A", "to_point": "B"}], "constraints": [{"type": "on_circle", "point": "A", "circle": "circ"}, {"type": "on_circle", "point": "B", "circle": "circ"}, {"type": "angle", "a": "A", "b": "O", "c": "B", "value": 60}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "画扇形 OAB，半径为 4，圆心角为 90°", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [4, 0]}, {"id": "B", "kind": "point", "hint": [0, 4]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "sec1", "kind": "sector", "center": "O", "from_point": "A", "to_point": "B"}], "constraints": [{"type": "length", "segment": "OA", "value": 4}, {"type": "length", "segment": "OB", "value": 4}, {"type": "angle", "a": "A", "b": "O", "c": "B", "value": 90}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "画一个正六边形 ABCDEF，边长为 4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "E", "kind": "point"}, {"id": "F", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DE", "kind": "segment", "a": "D", "b": "E"}, {"id": "EF", "kind": "segment", "a": "E", "b": "F"}, {"id": "FA", "kind": "segment", "a": "F", "b": "A"}, {"id": "hex", "kind": "polygon", "vertices": ["A", "B", "C", "D", "E", "F"]}], "constraints": [{"type": "regular_polygon", "polygon": "hex", "sides": 6}, {"type": "length", "segment": "AB", "value": 4}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D", "E": "E", "F": "F"}}}
{"nl": "画一个等腰梯形 ABCD，AB 为上底长 6，CD 为下底长 10，高为 4", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "quad", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}], "constraints": [{"type": "trapezoid", "polygon": "quad", "bases": ["AB", "CD"]}, {"type": "length", "segment": "AB", "value": 6}, {"type": "length", "segment": "CD", "value": 10}, {"type": "equal_length", "segments": ["BC", "DA"]}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画椭圆 x²/9 + y²/4 = 1 的图像", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-4, 4], "y_range": [-3, 3], "tick_step": 1, "show_grid": true}, {"id": "c_top", "kind": "curve", "expr": "2*sqrt(1-x**2/9)", "var": "x", "domain": [-3, 3], "samples": 400, "color": "#0d6efd"}, {"id": "c_bot", "kind": "curve", "expr": "-2*sqrt(1-x**2/9)", "var": "x", "domain": [-3, 3], "samples": 400, "color": "#0d6efd"}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "圆 O 半径为 5，A、B 两点在圆上，画从 A 到 B 的弧，圆心角 AOB 为 60°", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [5, 0]}, {"id": "B", "kind": "point", "hint": [2.5, 4.33]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 5}}, {"id": "arc1", "kind": "arc", "center": "O", "from_point": "A", "to_point": "B"}], "constraints": [{"type": "on_circle", "point": "A", "circle": "circ"}, {"type": "on_circle", "point": "B", "circle": "circ"}, {"type": "arc_angle", "arc": "arc1", "value": 60}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "圆 O 半径为 2，画弧 AB 使弧长为 π", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [2, 0]}, {"id": "B", "kind": "point", "hint": [0, 2]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 2}}, {"id": "arc1", "kind": "arc", "center": "O", "from_point": "A", "to_point": "B"}], "constraints": [{"type": "length", "segment": "OA", "value": 2}, {"type": "arc_length", "arc": "arc1", "value": 3.141592653589793}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "半径为 2 的圆中，画一个面积为 2π 的弓形（弧 + 弦围成的区域）", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [2, 0]}, {"id": "B", "kind": "point", "hint": [-2, 0]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "circ", "kind": "circle", "definition": {"type": "center_radius", "center": "O", "radius": 2}}, {"id": "arc1", "kind": "arc", "center": "O", "from_point": "A", "to_point": "B"}], "constraints": [{"type": "length", "segment": "OA", "value": 2}, {"type": "bow_area", "arc": "arc1", "value": 6.283185307179586}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "画一个扇形 OAB 并填充阴影，半径 4，圆心角 90°", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [4, 0]}, {"id": "B", "kind": "point", "hint": [0, 4]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "arc1", "kind": "arc", "center": "O", "from_point": "A", "to_point": "B"}, {"id": "sec1", "kind": "sector", "center": "O", "from_point": "A", "to_point": "B"}, {"id": "shaded", "kind": "region", "boundary": ["OA", "arc1", "OB"], "fill_color": "#0d6efd", "fill_opacity": 0.2, "stroke": "#222"}], "constraints": [{"type": "length", "segment": "OA", "value": 4}, {"type": "length", "segment": "OB", "value": 4}, {"type": "angle", "a": "A", "b": "O", "c": "B", "value": 90}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "画一条数轴，在数轴上标出 -3 和 5 两个点", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [-3, 0]}, {"id": "B", "kind": "point", "hint": [5, 0]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "nl", "kind": "number_line", "origin": "O", "range": [-5, 6], "tick_step": 1}], "constraints": [{"type": "length", "segment": "OA", "value": 3}, {"type": "length", "segment": "OB", "value": 5}], "labels": {"O": "O", "A": "A", "B": "B"}}}
{"nl": "在 5×5 网格中画一个矩形 ABCD，顶点都在格点上，AB=4，BC=3", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [-2, -1]}, {"id": "B", "kind": "point", "hint": [2, -1]}, {"id": "C", "kind": "point", "hint": [2, 2]}, {"id": "D", "kind": "point", "hint": [-2, 2]}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "CD", "kind": "segment", "a": "C", "b": "D"}, {"id": "DA", "kind": "segment", "a": "D", "b": "A"}, {"id": "rect", "kind": "polygon", "vertices": ["A", "B", "C", "D"]}, {"id": "ax", "kind": "axis", "origin": "O", "x_range": [-3, 3], "y_range": [-2, 3], "tick_step": 1, "show_grid": true, "grid_size": 1}], "constraints": [{"type": "length", "segment": "AB", "value": 4}, {"type": "length", "segment": "BC", "value": 3}, {"type": "perpendicular", "a": "AB", "b": "BC"}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画三角形 ABC，AB=AC=5，BC=6，作 BC 边上的高 AD（虚线辅助线）", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point"}, {"id": "B", "kind": "point"}, {"id": "C", "kind": "point"}, {"id": "D", "kind": "point"}, {"id": "AB", "kind": "segment", "a": "A", "b": "B"}, {"id": "AC", "kind": "segment", "a": "A", "b": "C"}, {"id": "BC", "kind": "segment", "a": "B", "b": "C"}, {"id": "AD_seg", "kind": "segment", "a": "A", "b": "D"}, {"id": "AD_aux", "kind": "aux_line", "a": "A", "b": "D", "extended": false}, {"id": "tri", "kind": "polygon", "vertices": ["A", "B", "C"]}], "constraints": [{"type": "length", "segment": "AB", "value": 5}, {"type": "length", "segment": "AC", "value": 5}, {"type": "length", "segment": "BC", "value": 6}, {"type": "midpoint", "m": "D", "a": "B", "b": "C"}, {"type": "perpendicular", "a": "AD_seg", "b": "BC"}], "labels": {"A": "A", "B": "B", "C": "C", "D": "D"}}}
{"nl": "画一个棱长为 4 的正方体 ABCD-A'B'C'D'", "dsl": {"version": "0.1", "objects": [{"id": "A", "kind": "point", "hint": [0, 0]}, {"id": "cube1", "kind": "cube", "vertex": "A", "edge": 4}], "constraints": [], "labels": {"A": "A"}}}
{"nl": "画一个底面半径为 3、高为 5 的圆柱", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "cyl1", "kind": "cylinder", "center_bottom": "O", "radius": 3, "height": 5}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画一个半径为 4 的球", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "sph1", "kind": "sphere", "center": "O", "radius": 4}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画条形统计图，A=3, B=5, C=7, D=4", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "bc1", "kind": "bar_chart", "origin": "O", "data": [3, 5, 7, 4], "labels": ["A", "B", "C", "D"], "width": 8, "height": 6}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画扇形统计图，A 占 30%，B 占 40%，C 占 30%", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "pc1", "kind": "pie_chart", "center": "O", "data": [30, 40, 30], "labels": ["A", "B", "C"], "radius": 3}], "constraints": [], "labels": {"O": "O"}}}
{"nl": "画外半径 4 内半径 2 圆心角 90° 的扇环", "dsl": {"version": "0.1", "objects": [{"id": "O", "kind": "point", "hint": [0, 0]}, {"id": "A", "kind": "point", "hint": [4, 0]}, {"id": "B", "kind": "point", "hint": [0, 4]}, {"id": "OA", "kind": "segment", "a": "O", "b": "A"}, {"id": "OB", "kind": "segment", "a": "O", "b": "B"}, {"id": "ans1", "kind": "annular_sector", "center": "O", "from_point": "A", "to_point": "B", "r_inner": 2.0, "ccw": true}], "constraints": [{"type": "length", "segment": "OA", "value": 4}, {"type": "perpendicular", "a": "OA", "b": "OB"}], "labels": {"O": "O", "A": "A", "B": "B"}}}
