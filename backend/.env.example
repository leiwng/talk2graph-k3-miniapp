# ============================================================
# 话图 T2G 后端配置
# 复制本文件为 .env 并填入你的 Key（.env 已加入 .gitignore）
# ============================================================

# ----- 用户管理（V2-F.1） -----
# JWT HS256 签名密钥。开发期可用默认值；生产期必须替换为长随机串：
#   openssl rand -hex 32
T2G_JWT_SECRET=dev-only-change-in-prod-please-use-32+-chars
# JWT 过期时间（秒），默认 86400 = 24h
# T2G_JWT_EXPIRY_SECONDS=86400
# Bootstrap admin：首次启动且 DB 中无 admin 用户时，按这两个 env 自动创建一个管理员账号
# 创建成功后这两个 env 可删除（账号之后改密走 /api/auth/change-password 流程）
# 开发期可留空，手动用 sqlite3 改 role='admin'；生产期必填
T2G_BOOTSTRAP_ADMIN_EMAIL=
T2G_BOOTSTRAP_ADMIN_PASSWORD=

# ----- 邮箱验证 + 密码重置 + 微信 OAuth（P1 V2-F.3）-----
# 邮件 Provider：resend / smtp / console（默认，仅打日志不发真实邮件）
EMAIL_PROVIDER=console
# ====== Resend（开发期可选，免费 3000 封/月）======
# 申请：https://resend.com/api-keys
RESEND_API_KEY=
# 发件人地址（Resend 免费版用 onboarding@resend.dev；自有域名可用 noreply@your-domain.com）
EMAIL_FROM=onboarding@resend.dev
# ====== SMTP（生产期推荐：腾讯企业邮箱 / 飞书企业邮箱 / 阿里云邮件推送）======
# 适用于任何标准 SMTP 服务器。
# 飞书企业邮箱（推荐）：host=smtp.feishu.cn port=465 use_tls=true
# 腾讯企业邮箱：          host=smtp.exmail.qq.com port=465 use_tls=true
# 阿里云邮件推送：        host=smtpdm.aliyun.com port=465 use_tls=true
# Gmail：                 host=smtp.gmail.com port=465 use_tls=true（需应用专用密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# 密码重置链接基础 URL（前端路由）。生产期填完整 URL：
#   PASSWORD_RESET_BASE_URL=https://t2g.yinhour.com/reset-password
PASSWORD_RESET_BASE_URL=/reset-password
# 微信开放平台 PC 扫码登录（开放平台 - 网站应用）
# 申请：https://open.weixin.qq.com/
# V3.5：拿到正式 AppID/Secret 后填入下面两个变量即可启用微信扫码登录
#       （代码框架已在 V3.2 P1 完成，无需改代码）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信扫码后回调到后端的 URL（必须与微信开放平台配置一致）
WECHAT_REDIRECT_URI=https://t2g.yinhour.com/api/auth/wechat/callback
# 微信扫码成功后前端跳转 URL（带 token 参数重定向）
WECHAT_FRONTEND_REDIRECT_URL=https://t2g.yinhour.com/wechat/callback
# 微信小程序登录（小程序 AppID，与上面开放平台的网站应用是两个不同应用）
# 申请：https://mp.weixin.qq.com/ （小程序后台 -> 开发管理 -> 开发设置）
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# ----- 支付宝（V2-F.2）-----
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式：https://openapi.alipay.com/gateway.do
# 密钥文件放在宿主机 ./secrets/ 目录，docker-compose 会挂载到容器内 /app/secrets/
# 宿主机路径示例：/opt/talk2graph-glm/secrets/app_private_key.pem
# 容器内路径（.env 里填这个）：/app/secrets/app_private_key.pem
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_FILE=/app/secrets/app_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=/app/secrets/alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://t2g.yinhour.com/api/webhooks/alipay
ALIPAY_RETURN_URL=https://t2g.yinhour.com/account/subscription
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ----- 生产 / 调试 UI 切换 -----
# true: 前端显示 Provider 切换、对象面板、约束编辑器（开发期）
# false: 前端隐藏上述控件，仅显示对话+画板，LLM 由 fallback chain 自动选（生产期）
T2G_DEBUG_UI=false

# ----- LLM Fallback Chain（provider:model，逗号分隔，不设个数上限）-----
# 当第一个 provider 出错（网络/超时/5xx/限流/鉴权）时自动切到下一个
# 每条必须同时写 provider 和 model；provider 可选：zhipu / volcengine / deepseek / minimax / kimi / bailian
# 格式错误（缺 model / 未知 provider）会在启动时直接报错
# 留空 = 自动取全部 enabled provider，default 排第一
# 示例：T2G_FALLBACK_PROVIDERS=deepseek:deepseek-v4-flash,bailian:qwen3.8-max,volcengine:glm-5.2
T2G_FALLBACK_PROVIDERS=

# ----- 默认 Provider（前端首次打开预选；后端找不到对应 Key 时返回 disabled） -----
DEFAULT_PROVIDER=zhipu

# ----- 智谱 BigModel -----
# 申请：https://open.bigmodel.cn/
ZHIPU_API_KEY=
# 可选：覆盖默认 endpoint / 模型
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4.5            # GLM-5.2 上线后改成 glm-5.2

# ----- 火山引擎方舟 Ark -----
# 在火山方舟控制台创建"接入点（Endpoint）"，承载任意你已开通的模型
# （包括但不限于 GLM-5.2 / DeepSeek / 豆包），然后把 Endpoint ID 填到下面
# 申请：https://www.volcengine.com/product/ark
VOLCENGINE_API_KEY=
VOLCENGINE_ENDPOINT_ID=           # 形如 ep-2024xxxx-xxxxx
# 可选：覆盖默认区域 endpoint
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ----- DeepSeek -----
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# 可选
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat   # V4 Pro 上线后按官方文档改

# ----- MiniMax -----
# 申请：https://platform.minimaxi.com/
MINIMAX_API_KEY=
# 可选
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M3

# ----- Kimi (Moonshot AI) -----
# 申请：https://platform.moonshot.cn/
MOONSHOT_API_KEY=
# 可选
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k2.6        # 可选：kimi-k2.6 / kimi-k2.7-code / kimi-k2.7-code-highspeed

# ----- 阿里云百炼 DashScope（OpenAI 兼容）-----
# 申请：https://bailian.console.aliyun.com/
BAILIAN_API_KEY=
# 可选
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL=qwen-max

# ============================================================
# 多模型注册说明
# ============================================================
# router 启动时自动注册以下 Provider（共用对应 API Key，无需额外配置）：
#
#   volcengine_doubao_pro    → Doubao-Seed-2.0-pro            (VOLCENGINE_API_KEY)
#   deepseek_v4_pro          → deepseek-v4-pro               (DEEPSEEK_API_KEY)
#   kimi_k26                 → kimi-k2.6                     (MOONSHOT_API_KEY)
#   kimi_k27_code            → kimi-k2.7-code                (MOONSHOT_API_KEY)
#   kimi_k27_code_hs         → kimi-k2.7-code-highspeed       (MOONSHOT_API_KEY)
#
# 前端 ProviderSwitch 会列出所有已注册 Provider。
# DEFAULT_PROVIDER 可选上述任意 name。

# ============================================================
# 场景示例
# ============================================================
# 场景 1：通过智谱 BigModel 用 GLM-5.2
#   ZHIPU_API_KEY=sk-xxxxx
#   ZHIPU_MODEL=glm-5.2
#   DEFAULT_PROVIDER=zhipu
#
# 场景 2：通过火山方舟用 GLM-5.2（火山转售）
#   VOLCENGINE_API_KEY=xxxxx
#   VOLCENGINE_ENDPOINT_ID=ep-xxxx-glm52
#   DEFAULT_PROVIDER=volcengine
#
# 场景 3：同时配多家，老师在 UI 自由切换 — 把全部 Key 都填上即可
# ============================================================

# ----- 日志 -----
LOG_LEVEL=INFO
# 以下为本地开发用；Docker 部署时不要保留这两行（让 Dockerfile 的 ENV 生效）
# DATABASE_URL=sqlite+aiosqlite:///./data/talk2graph.db
# LOG_DIR=./logs
